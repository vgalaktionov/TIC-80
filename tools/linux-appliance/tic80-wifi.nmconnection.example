# Rename to tic80-wifi.nmconnection on the boot partition and fill in credentials.
# This is a NetworkManager keyfile, NOT a shell script. Do not quote values.
[connection]
id=tic80-wifi
type=wifi
autoconnect=true

[wifi]
mode=infrastructure
ssid=YOUR_SSID

[wifi-security]
key-mgmt=wpa-psk
psk=YOUR_PASSWORD

[ipv4]
method=auto

[ipv6]
method=auto
